{
  "version": 1,
  "tools": [
    {
      "id": "shopify",
      "name": "Shopify",
      "adapter": "statuspage",
      "url": "https://www.shopifystatus.com/api/v2/summary.json",
      "enabled": true
    },
    {
      "id": "vtex",
      "name": "VTEX",
      "adapter": "statuspage",
      "url": "https://status.vtex.com/api/v2/summary.json",
      "enabled": true
    },
    {
      "id": "salesforce",
      "name": "Salesforce",
      "adapter": "custom",
      "customAdapter": "salesforce",
      "url": "https://api.status.salesforce.com/v1",
      "enabled": true,
      "notes": "Uses Salesforce Trust API (active incidents + in-window maintenance)."
    },
    {
      "id": "adobe-experience-manager",
      "name": "Adobe Experience Manager",
      "adapter": "custom",
      "customAdapter": "adobe-aem",
      "url": "https://data.status.adobe.com/adobestatus/StatusEvents",
      "enabled": true,
      "options": {
        "productIds": ["503489", "503470"]
      },
      "notes": "Monitors AEM and AEM as a Cloud Service via Adobe Status Events feed."
    },
    {
      "id": "zendesk",
      "name": "Zendesk",
      "adapter": "custom",
      "customAdapter": "zendesk",
      "url": "https://status.zendesk.com",
      "enabled": true,
      "notes": "Zendesk public Status API (active incidents + maintenance windows)."
    },
    {
      "id": "snowflake",
      "name": "Snowflake",
      "adapter": "statuspage",
      "url": "https://status.snowflake.com/api/v2/summary.json",
      "enabled": true
    },
    {
      "id": "github",
      "name": "GitHub",
      "adapter": "statuspage",
      "url": "https://www.githubstatus.com/api/v2/summary.json",
      "enabled": true
    },
    {
      "id": "google-cloud",
      "name": "GCP",
      "adapter": "gcloud",
      "url": "https://status.cloud.google.com/incidents.json",
      "enabled": true,
      "alerting": {
        "scope": {
          "products": ["Cloud Run", "Cloud Storage", "BigQuery"],
          "regions": ["europe-west1", "europe-west2", "europe-west4"],
          "behavior": "ignore_unscoped"
        }
      },
      "notes": "Optional alerting.scope filters open incidents to products/regions in use."
    },
    {
      "id": "paypal",
      "name": "PayPal",
      "adapter": "custom",
      "customAdapter": "paypal-atom",
      "url": "https://www.paypal-status.com/feed/atom",
      "enabled": true,
      "notes": "PayPal has no public Statuspage JSON; Atom feed is parsed for active incidents."
    },
    {
      "id": "true-loyal",
      "name": "True Loyal (formerly Zinrelo)",
      "adapter": "custom",
      "customAdapter": "betterstack",
      "url": "https://status.trueloyal.com/index.json",
      "enabled": true,
      "notes": "TrueLoyal public status (Better Stack)."
    },
    {
      "id": "stibo",
      "name": "Stibo",
      "adapter": "custom",
      "customAdapter": "statushub",
      "url": "https://statushub.mdm.stibosystems.com/",
      "enabled": true,
      "notes": "Stibo StatusHub public API (/api/statuses)."
    },
    {
      "id": "tiktok-business-api",
      "name": "TikTok",
      "adapter": "custom",
      "customAdapter": "tiktok-api",
      "url": "https://business-api.tiktok.com/portal/api-service-status",
      "enabled": true,
      "notes": "TikTok Marketing API status_page incident list (Referer required)."
    },
    {
      "id": "bazaarvoice",
      "name": "Bazaarvoice",
      "adapter": "statuspage",
      "url": "https://status.bazaarvoice.com/api/v2/summary.json",
      "enabled": true
    },
    {
      "id": "powerreviews",
      "name": "PowerReviews",
      "adapter": "custom",
      "customAdapter": "pingdom-public",
      "url": "https://status.powerreviews.com/",
      "enabled": true,
      "options": {
        "ignoreCheckNamePatterns": ["(?i)^legacy\\b"]
      },
      "notes": "Pingdom public checks JSON (/checks); Legacy APIs check is retired."
    },
    {
      "id": "ariba",
      "name": "Ariba",
      "adapter": "custom",
      "customAdapter": "ariba-portal",
      "url": "https://s1.ariba.com/gb/?realm=colpalc2&locale=en_US",
      "enabled": true,
      "notes": "Guided Buying portal reachability (login redirects treated as up)."
    },
    {
      "id": "mediafly",
      "name": "Mediafly",
      "adapter": "statuspage",
      "url": "https://mediafly.statuspage.io/api/v2/summary.json",
      "enabled": true
    },
    {
      "id": "sigma",
      "name": "Sigma",
      "adapter": "statuspage",
      "url": "https://status.sigmacomputing.com/api/v2/summary.json",
      "enabled": true,
      "statusPageUrl": "https://status.sigmacomputing.com",
      "notes": "Sigma Computing public Statuspage."
    },
    {
      "id": "domo",
      "name": "Domo",
      "adapter": "custom",
      "customAdapter": "domo-status",
      "url": "https://status.domo.com/",
      "enabled": true,
      "statusPageUrl": "https://status.domo.com/",
      "notes": "Domo service health JSON at /status."
    },
    {
      "id": "stripe",
      "name": "Stripe",
      "adapter": "custom",
      "customAdapter": "stripe-status",
      "url": "https://status.stripe.com/",
      "enabled": true,
      "notes": "Stripe legacy status JSON at /current."
    },
    {
      "id": "hawthorne-mckenzie",
      "name": "Hawthorne McKenzie Digital",
      "adapter": "http-ping",
      "url": "https://example.com",
      "enabled": false,
      "notes": "Set url to the site you need monitored, then enable."
    }
  ]
}
