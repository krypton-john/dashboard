{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized status snapshot",
  "type": "object",
  "required": ["lastPolledAt", "generatedAt", "tools"],
  "additionalProperties": false,
  "properties": {
    "lastPolledAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "When vendors were last polled (updates every run)"
    },
    "generatedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "When tool state or descriptions last changed"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "state", "description", "polledAt", "error"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "state": {
            "type": "string",
            "enum": [
              "operational",
              "future-maintenance",
              "degraded",
              "major",
              "unknown"
            ]
          },
          "description": { "type": "string" },
          "polledAt": { "type": "string", "format": "date-time" },
          "error": { "type": ["string", "null"] },
          "daysSinceLastIncident": { "type": ["integer", "null"] },
          "incidentOngoing": { "type": "boolean" },
          "trackingSince": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  }
}
